# Settings of an AutoCanvas instance for docker compose. The install script writes this file as
# .env; to install by hand, copy it to .env next to compose.yaml and fill it in.

# The compose project; its volumes are named after it (<project>_data, <project>_keys, …).
COMPOSE_PROJECT_NAME=autocanvas

# compose.yaml alone uses SQLite. With PostgreSQL:
#   COMPOSE_FILE=compose.yaml:compose.postgres.yaml   (on Windows: compose.yaml;compose.postgres.yaml)
COMPOSE_FILE=compose.yaml

# The ports on this machine: the web UI and the API, and the runner endpoint for other runners.
AUTOCANVAS_PORT=5080
AUTOCANVAS_RUNNER_PORT=5081

# The images; until the first release they are built from a checkout as ':local'.
AUTOCANVAS_SERVER_IMAGE=autocanvas-server:local
AUTOCANVAS_RUNNER_IMAGE=autocanvas-runner:local

# The group that owns the Docker socket, as the runner's container sees it:
#   docker run --rm -v /var/run/docker.sock:/s alpine:3.22 stat -c %g /s
AUTOCANVAS_DOCKER_GID=0

# Where the runner's volume is on the Docker host, after 'docker compose create':
#   docker volume inspect -f '{{ .Mountpoint }}' autocanvas_runner
AUTOCANVAS_RUNNER_HOST_DATA=

# The bundled runner's name.
AUTOCANVAS_RUNNER_NAME=bundled

# Reverse proxies in front of AutoCanvas whose forwarded headers are believed, e.g. 172.16.0.0/12.
AUTOCANVAS_TRUSTED_PROXIES=

# Only with compose.postgres.yaml: the database password, long and random.
AUTOCANVAS_POSTGRES_PASSWORD=
