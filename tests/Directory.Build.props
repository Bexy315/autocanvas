<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Test code is not public API. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- AutoCanvas.TestSupport is a shared library for the test projects, not a test project itself. -->
    <AutoCanvasTestProject Condition="'$(MSBuildProjectName)' != 'AutoCanvas.TestSupport'">true</AutoCanvasTestProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AutoCanvasTestProject)' == 'true'">
    <OutputType>Exe</OutputType>
    <!-- Coverage gate: each test project measures the source project it is named after
         (a project can widen this with CoverageInclude, see Directory.Build.targets). -->
    <CoveredAssembly>$(MSBuildProjectName.Replace('.Tests', ''))</CoveredAssembly>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup Condition="'$(AutoCanvasTestProject)' == 'true'">
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup Condition="'$(AutoCanvasTestProject)' == 'true'">
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/$(CoveredAssembly)/$(CoveredAssembly).csproj" />
  </ItemGroup>
</Project>
